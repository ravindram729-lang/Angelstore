# Required/strongly recommended for network or production deployment
# Never put real production secrets in this file or in source control.
PORT=8000
NODE_ENV=production

ANGELSTORE_ADMIN_USER=change-me
ANGELSTORE_ADMIN_PASS=change-me-to-a-strong-password-12chars-min
ANGELSTORE_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
ANGELSTORE_CORS_ORIGIN=https://your-production-domain.example

# Persistent storage root. On an ephemeral host, point this to the provider's persistent disk mount.
ANGELSTORE_STORAGE_DIR=/var/data/angelstore
# Optional overrides; otherwise these are created under ANGELSTORE_STORAGE_DIR.
# ANGELSTORE_UPLOAD_DIR=/var/data/angelstore/uploads/payments
# ANGELSTORE_BACKUP_DIR=/var/data/angelstore/backups

# Scheduled + off-site backup (Phase 28 / 37)
# Set an HTTPS endpoint that accepts POST JSON backup bundles.
ANGELSTORE_SCHEDULED_BACKUP=true
ANGELSTORE_BACKUP_INTERVAL_HOURS=24
ANGELSTORE_BACKUP_RETENTION=14
ANGELSTORE_OFFSITE_BACKUP_URL=
ANGELSTORE_OFFSITE_BACKUP_TOKEN=

# Incident monitoring / alerts (Phase 30)
ANGELSTORE_ALERT_WEBHOOK_URL=
ANGELSTORE_ALERT_WEBHOOK_TOKEN=
ANGELSTORE_MONITOR_INTERVAL_MINUTES=15
ANGELSTORE_BACKUP_OVERDUE_MULTIPLIER=1.5

# Optional: audit/notification log retention in data.json
# ANGELSTORE_AUDIT_RETENTION=2000

# Optional application-level encryption for off-site backups
ANGELSTORE_OFFSITE_BACKUP_ENCRYPTION_KEY=
ANGELSTORE_OCR_MAX_CONCURRENCY=2


# UPPCL is intentionally Admin-managed and manual in Angelstore.
# Customer enters bill details manually; Admin verifies and processes manually.
